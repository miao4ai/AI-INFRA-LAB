# ======================================================================
# Extensionless in-source example binaries
# ----------------------------------------------------------------------
# Examples build in-source and drop an extensionless Mach-O/ELF binary
# next to their CMakeLists.txt (e.g. 01_basics/const/const). Source lives
# under src/, which must stay tracked.
#
# Ignore everything two levels below a numbered chapter dir
#   NN_name/<example>/<file>
# then re-include files that have an extension (source, CMakeLists.txt)
# and all directories (so src/ is still traversed). What is left ignored
# is exactly the extensionless compiled binaries.
[0-9][0-9]_*/*/*
![0-9][0-9]_*/*/*.*
![0-9][0-9]_*/*/*/

# Same idea for the Deep Learning course exercises:
#   deep_learning_modern_C_plus/chapter-NN/exM_name/<binary>
deep_learning_modern_C_plus/chapter-*/*/*
!deep_learning_modern_C_plus/chapter-*/*/*.*
!deep_learning_modern_C_plus/chapter-*/*/*/

# ======================================================================
# Build artifacts — listed AFTER the block above so they take precedence
# over the "re-include anything with a dot" rule and stay ignored.
# ======================================================================

# Out-of-source build directories
build/
cmake-build-*/
out/

# CMake in-source artifacts
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
CMakeUserPresets.json
Makefile

# Compiled objects, libraries, and binaries
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out

# macOS
.DS_Store
